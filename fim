<!DOCTYPE html>
<html lang="pt-BR">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>O Encontro com o Destino - Fim</title>
    <link href="https://fonts.googleapis.com/css2?family=Cinzel:wght@700&family=Orbitron:wght@400;700&family=Lora:ital,wght@0,400;0,600;1,400&display=swap" rel="stylesheet">
    <style>
        :root {
            --azul-cosmos: #03081e;
            --ouro-escuro: #4a3b13;
            --ouro-brilhante: #8c7333;
            --prata-metal: linear-gradient(135deg, #e2e8f0 0%, #94a3b8 50%, #64748b 100%);
            --texto-cor: #211a10;
        }

        * { box-sizing: border-box; }
        html { scroll-behavior: smooth; }

        body {
            margin: 0; padding: 0;
            width: 100%; min-height: 100vh;
            background-color: var(--azul-cosmos);
            font-family: 'Lora', serif;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 60px 20px;
            overflow-x: hidden;
            opacity: 0; /* Começa invisível para o efeito fade-in */
            transition: opacity 1.5s ease;
        }

        /* FUNDO CÓSMICO */
        #fundo-cosmos {
            position: fixed;
            top: 0; left: 0; width: 100%; height: 100%;
            z-index: -1;
            background: radial-gradient(circle at center, #0a163a 0%, var(--azul-cosmos) 100%);
        }

        /* TÍTULO SUPREMO EM JORNADA */
        .titulo-final {
            font-family: 'Cinzel', serif;
            font-size: 2.5rem;
            text-transform: uppercase;
            letter-spacing: 6px;
            text-align: center;
            margin-bottom: 40px;
            background: var(--prata-metal);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(2px 4px 10px rgba(0, 0, 0, 0.9));
            font-weight: 700;
        }

        /* MOLDURA DE OURO COMPLETA */
        .card-principal {
            max-width: 800px;
            width: 100%;
            background: var(--ouro-escuro);
            padding: 14px;
            border-radius: 20px;
            box-shadow: 0 30px 60px rgba(0,0,0,0.9), inset 0 0 20px rgba(140, 115, 51, 0.6);
        }

        .papel-antigo {
            background-color: #f5eed7;
            background-image: url('https://www.transparenttextures.com/patterns/cream-paper.png');
            padding: 60px 40px;
            color: var(--texto-cor);
            border-radius: 12px;
            border: 2px solid var(--ouro-brilhante);
            box-shadow: inset 0 0 40px rgba(74, 59, 19, 0.25);
            text-align: center;
        }

        /* PAINEL DE AUDIO INLINE DISCRETO */
        .painel-musica-inline {
            background: rgba(3, 8, 30, 0.95);
            border: 1px solid var(--ouro-brilhante);
            padding: 12px 25px;
            border-radius: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 15px;
            margin-bottom: 40px;
            box-shadow: 0 8px 20px rgba(0,0,0,0.3);
        }

        .btn-controle {
            background: var(--ouro-escuro);
            border: 1px solid var(--ouro-brilhante);
            color: #fff;
            padding: 6px 16px;
            border-radius: 15px;
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            cursor: pointer;
            transition: 0.3s;
        }

        .btn-controle:hover { background: var(--ouro-brilhante); }
        .vol-slider { cursor: pointer; accent-color: var(--ouro-brilhante); width: 100px; }

        /* CARD INTERNO DO DESFECHO */
        .card-desfecho {
            background: #fdfbf7;
            border: 3px solid #cbd5e1;
            border-radius: 15px;
            padding: 50px 30px;
            box-shadow: 0 15px 35px rgba(0,0,0,0.1);
        }

        .texto-conclusao {
            font-size: 1.25rem;
            line-height: 2;
            text-align: justify;
            margin-bottom: 40px;
        }

        /* CONSTELAÇÃO DE ENCERRAMENTO */
        .simbolo-destino {
            font-size: 3rem;
            color: var(--ouro-brilhante);
            margin: 30px 0;
            filter: drop-shadow(0 0 8px rgba(140, 113, 51, 0.5));
            animation: pulsar 3s infinite ease-in-out;
        }

        .mensagem-final {
            font-family: 'Cinzel', serif;
            font-size: 1.8rem;
            letter-spacing: 4px;
            color: var(--ouro-escuro);
            font-weight: bold;
            margin-top: 20px;
        }

        /* CRÉDITOS DA CAMINHADA */
        .creditos {
            font-family: 'Orbitron', sans-serif;
            font-size: 0.75rem;
            color: #64748b;
            text-transform: uppercase;
            letter-spacing: 3px;
            margin-top: 50px;
        }

        @keyframes pulsar {
            0%, 100% { transform: scale(1); opacity: 0.8; }
            50% { transform: scale(1.1); opacity: 1; filter: drop-shadow(0 0 15px var(--ouro-brilhante)); }
        }

        @media (max-width: 600px) {
            .titulo-final { font-size: 1.7rem; letter-spacing: 3px; }
            .papel-antigo { padding: 40px 20px; }
            .texto-conclusao { font-size: 1.1rem; line-height: 1.8; }
            .mensagem-final { font-size: 1.4rem; }
        }
    </style>
</head>
<body onclick="iniciarAudio()">

    <div id="fundo-cosmos"></div>

    <!-- TÍTULO DE ENCERRAMENTO -->
    <h1 class="titulo-final">O Destino Encontrado</h1>

    <!-- CONTAINER DA MOLDURA -->
    <div class="card-principal">
        <div class="papel-antigo">
            
            <!-- PAINEL DE CONTROLE DE MÚSICA -->
            <div class="painel-musica-inline" onclick="event.stopPropagation()">
                <button class="btn-controle" id="playPause">PAUSE</button>
                <div style="display:flex; align-items:center; gap:8px;">
                    <span style="color:white; font-size:12px;">🔈</span>
                    <input type="range" class="vol-slider" min="0" max="1" step="0.1" value="1" oninput="ajustarVol(this.value)">
                    <span style="color:white; font-size:12px;">🔊</span>
                </div>
            </div>

            <!-- CONTEÚDO FINAL -->
            <div class="card-desfecho">
                
                <div class="simbolo-destino">✦</div>

                <p class="texto-conclusao">
                    A estrada longa ficou para trás e as dores do caminho transformaram-se em preciosas pérolas de sabedoria. Sob o manto infinito do cosmos, você compreendeu que cada curva perigosa, cada grão de areia e cada passo incerto faziam parte de um plano maior. Você não apenas cruzou o horizonte; você se tornou parte dele.
                </p>

                <div class="mensagem-final">FIM DA JORNADA</div>

                <div class="creditos">Obrigado por caminhar conosco</div>

            </div>

        </div>
    </div>

    <!-- ELEMENTO DE ÁUDIO REUTILIZADO -->
    <audio id="trilha" src="elvis.html.mp3" loop></audio>

    <script>
        const audio = document.getElementById('trilha');
        const btnPP = document.getElementById('playPause');

        // Garante transição suave ao entrar e recupera a trilha sonora sem interrupção
        window.onload = () => {
            // Efeito Fade-In da página inteira
            document.body.style.opacity = '1';

            // Resgata o tempo que parou em estrada.html
            const tempoSalvo = localStorage.getItem('musica_tempo');
            if (tempoSalvo) {
                audio.currentTime = parseFloat(tempoSalvo);
            }
            
            audio.play().then(() => {
                btnPP.innerText = "PAUSE";
            }).catch(() => {
                btnPP.innerText = "PLAY";
            });
        };

        function iniciarAudio() {
            if (audio.paused) {
                audio.play();
                btnPP.innerText = "PAUSE";
            }
        }

        btnPP.onclick = (e) => {
            e.stopPropagation();
            if (audio.paused) {
                audio.play();
                btnPP.innerText = "PAUSE";
            } else {
                audio.pause();
                btnPP.innerText = "PLAY";
            }
        };

        function ajustarVol(v) { audio.volume = v; }
    </script>
</body>
</html>
